local function YUKLL_fake_script() -- ON.LocalScript 
	local script = Instance.new('LocalScript', ON)

	local gyro = Instance.new("BodyGyro")
	script.Parent.Activated:Connect(function()
		local player = game.Players.LocalPlayer.Character
		local playerPos = player.HumanoidRootPart.CFrame
		local offset = CFrame.Angles(math.rad(90), 0, 0)
		player.Humanoid.PlatformStand = true
		wait(2)
		gyro.Parent = player.HumanoidRootPart
		gyro.CFrame = playerPos * offset
	end)
end
coroutine.wrap(YUKLL_fake_script)()
